"""
Connections: MAX7219 LED Matrix to Raspberry Pi Pico W
 * VCC -> VBUS (5V, physical pin 40)
 * GND -> GND (physical pin 3)
 * DIN -> GPIO3 (physical pin 5)
 * CS  -> GPIO5 (physical pin 7)
 * CLK -> GPIO2 (physical pin 4)

Connections: OLED SSD1306 I2C Display
 * VCC -> 3V3 OUT (physical pin 36)
 * GND -> GND (physical pin 38)
 * SCL -> GPIO7 (physical pin 10)
 * SDA -> GPIO6 (physical pin 9)

Connections: Analog Keypad 1
 * VCC    -> 3V3 OUT (physical pin 36)
 * GND    -> GND
 * Signal -> GP26 (ADC0, physical pin 31)

Connections: Analog Keypad 2 (currently disconnected)
 * Signal -> GP27 (ADC1, physical pin 32)
"""

from machine import Pin, SPI, ADC, SoftI2C
import utime

#vars
brightness = 5
WIDTH = 128
HEIGHT = 64
results = []

def report(name, success, details=""):
    status = "PASS" if success else "FAIL"
    print(f"[{status}] {name}: {details}")
    results.append(success)

#test 1: I2C scan
print("\n--- I2C SCAN ---")
i2c = SoftI2C(scl=Pin(7), sda=Pin(6), freq=100000)
devices = i2c.scan()
print("Detected addresses:", [hex(device) for device in devices])

oled_address = None
if 0x3C in devices:
    oled_address = 0x3C
elif 0x3D in devices:
    oled_address = 0x3D

report("I2C bus", len(devices) > 0, str([hex(device) for device in devices]))
report("SSD1306 OLED address", oled_address is not None,
       hex(oled_address) if oled_address else "Not detected")

#test 2: OLED
print("\n--- OLED TEST ---")
if oled_address is not None:
    try:
        from ssd1306 import SSD1306_I2C
        oled = SSD1306_I2C(WIDTH, HEIGHT, i2c, addr=oled_address)
        oled.fill(0)
        oled.text("OLED TEST", 0, 0)
        oled.text("Pico W", 0, 16)
        oled.text("I2C OK", 0, 32)
        oled.show()
        report("SSD1306 OLED", True, "Text displayed")
    except Exception as e:
        report("SSD1306 OLED", False, repr(e))
else:
    print("[SKIP] OLED initialization skipped because no expected address was detected.")

#test 3: MAX7219
print("\n--- MAX7219 TEST ---")
try:
    import max7219
    spi = SPI(0, baudrate=10000000, polarity=1, phase=0,
              sck=Pin(2), mosi=Pin(3))
    ss = Pin(5, Pin.OUT)
    display = max7219.Matrix8x8(spi, ss, 1)
    display.brightness(brightness)
    display.set_rotation(270)
    display.fill(0)

    # Draw a border
    for x in range(8):
        display.pixel(x, 0, 1)
        display.pixel(x, 7, 1)
    for y in range(8):
        display.pixel(0, y, 1)
        display.pixel(7, y, 1)

    display.show()
    report("MAX7219", True, "Border pattern displayed")
except Exception as e:
    display = None
    report("MAX7219", False, repr(e))

#test 4: Analog keypad 1
print("\n--- PLAYER 1 KEYPAD TEST ---")
try:
    keypad_1 = ADC(Pin(26))
    values = []
    for i in range(5):
        values.append(keypad_1.read_u16())
        utime.sleep_ms(100)
    average = sum(values) // len(values)
    report("Player 1 ADC", True, f"Readings={values}, average={average}")
    print("Press each keypad button and check whether the readings change.")
except Exception as e:
    report("Player 1 ADC", False, repr(e))

#test 5: Player 2 ADC (disconnected)
print("\n--- PLAYER 2 KEYPAD TEST ---")
try:
    keypad_2 = ADC(Pin(27))
    values = []
    for i in range(5):
        values.append(keypad_2.read_u16())
        utime.sleep_ms(100)
    print("[INFO] Player 2 is disconnected. ADC readings are informational only:", values)
except Exception as e:
    print("[INFO] Player 2 ADC test could not run:", repr(e))

#test 6: onboard LED
print("\n--- ONBOARD LED TEST ---")
try:
    led = Pin("LED", Pin.OUT)
    for i in range(4):
        led.toggle()
        utime.sleep_ms(250)
    led.on()
    report("Onboard LED", True, "Blink test completed")
except Exception as e:
    report("Onboard LED", False, repr(e))

#summary
print("\n--- TEST SUMMARY ---")
print(f"Passed: {sum(results)} / {len(results)}")
print("A successful I2C scan only confirms that a device responds, not that it is definitely an SSD1306.")
print("For the keypad, press each button and compare its ADC readings.")
